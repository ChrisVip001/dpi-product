# Copy to .env at the repo root. `just net up <id>` copies the keys listed under
# `env_keys` in dpi-network.yaml into each device's ~/.dpi/backend.env.

# DeepSeek direct (DPI_PROVIDER=deepseek)
DEEPSEEK_API_KEY=sk-...

# OpenRouter (DPI_PROVIDER=openrouter)
# OPENROUTER_API_KEY=sk-or-...

# Optional: call Jev through TypeSafe directly instead of OpenRouter
# TYPESAFE_API_KEY=
